---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  compact?: boolean;
}

const { project, index = 0, compact = false } = Astro.props;
const { data } = project;
---

<article class:list={['project-preview', { 'project-preview--compact': compact }]} data-reveal>
  <a class="project-media" href={`/projects/${project.id}/`} aria-label={`View case study: ${data.title}`}>
    <img
      src={data.cover}
      alt=""
      width="1200"
      height="800"
      loading={index === 0 && !compact ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="project-index" aria-hidden="true">0{data.order}</span>
  </a>
  <div class="project-copy">
    <div class="eyebrow-row">
      <p class="eyebrow">{data.category}</p>
      {data.timeframe && <p class="project-time">{data.timeframe}</p>}
    </div>
    <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
    <p>{data.description}</p>
    <p class="project-role">Role — {data.role}</p>
    <a class="text-link" href={`/projects/${project.id}/`}>
      Read case study <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

---
import { profile } from '../data/profile';
---

<section class="contact-section section-shell" id="contact" aria-labelledby="contact-title">
  <div class="contact-heading" data-reveal>
    <p class="section-number">05 / Contact</p>
    <h2 id="contact-title">Let’s build something useful.</h2>
    <p class="contact-intro">
      For front-end roles, project conversations, or a closer look at the work, reach out directly.
    </p>
  </div>

  <div class="contact-copy" data-reveal>
    <div class="contact-panel-heading">
      <p class="eyebrow">Direct channels</p>
      <p class="contact-availability"><span aria-hidden="true"></span> Open to opportunities</p>
    </div>

    <div class="contact-directory" aria-label="Contact details">
      <div class="contact-line">
        <span>Email</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button
          class="copy-button"
          type="button"
          data-copy-email
          data-email={profile.email}
          aria-describedby="copy-status"
        >
          Copy
        </button>
      </div>
      {profile.phone && (
        <div class="contact-line">
          <span>Phone</span>
          <a href={`tel:${profile.phone.replace(/[\s-]/g, '')}`}>{profile.phone}</a>
          <span aria-hidden="true">↗</span>
        </div>
      )}
      {profile.links.whatsapp && (
        <div class="contact-line">
          <span>WhatsApp</span>
          <a href={profile.links.whatsapp} target="_blank" rel="noreferrer">
            Start a chat<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <span aria-hidden="true">↗</span>
        </div>
      )}
      <div class="contact-line">
        <span>GitHub</span>
        <a href={profile.links.github} target="_blank" rel="noreferrer">
          @cacaarchivee<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <span aria-hidden="true">↗</span>
      </div>
    </div>
    <p class="contact-status" id="copy-status" role="status" aria-live="polite" data-copy-status></p>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');

  if (copyButton && copyStatus) {
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      try {
        if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(email);
        copyButton.textContent = 'Copied';
        copyStatus.textContent = `${email} copied to clipboard.`;
      } catch {
        copyButton.textContent = 'Open mail';
        copyStatus.textContent = 'Copy was unavailable. Opening your email app instead.';
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>

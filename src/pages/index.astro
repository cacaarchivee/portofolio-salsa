---
import { getCollection } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import {
  certifications,
  education,
  experience,
  organizations,
  skillGroups,
  supportingDocuments,
} from '../data/experience';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured);
---

<BaseLayout
  title={profile.name}
  description="Portfolio of Salsabilla Edlanda Putri, a Front-End Developer focused on Angular, TypeScript, and API-driven web applications."
  pageClass="home-page"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker">{profile.role} · Semarang, Indonesia</p>
      <p class="hero-name" aria-hidden="true">Salsabilla<br />Edlanda Putri</p>
      <h1 id="hero-title">I build clear, responsive interfaces for real-world applications.</h1>
      <p class="hero-intro">
        Angular and TypeScript development, REST API integration, and collaborative delivery experience for an Ireland-based company.
      </p>
      <div class="hero-actions">
        <a class="button" href="#work">View selected work <span aria-hidden="true">↓</span></a>
        {profile.cvPath && (
          <a class="text-link" href={profile.cvPath} download>Download CV <span aria-hidden="true">↓</span></a>
        )}
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true" data-depth>
      <div class="hero-orbit hero-orbit--one"></div>
      <div class="hero-orbit hero-orbit--two"></div>
      <span class="hero-monogram">SEP</span>
      <div class="hero-note">
        <span>Interfaces</span>
        <span>Systems</span>
        <span>Clarity</span>
      </div>
    </div>
    <p class="hero-scroll" aria-hidden="true">Scroll to explore <span>↓</span></p>
  </section>

  <section class="work-section section-shell" id="work" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <p class="section-number">01 / Selected work</p>
      <div>
        <h2 id="work-title">Built for use,<br />not just display.</h2>
        <p>
          Selected projects across professional product work and full-stack academic development.
        </p>
      </div>
    </div>
    <div class="selected-work">
      {featuredProjects.map((project, index) => (
        <ProjectPreview project={project} index={index} />
      ))}
    </div>
    <a class="section-link" href="/projects/">
      Explore all six projects <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="experience-section section-shell" id="experience" aria-labelledby="experience-title">
    <div class="section-heading section-heading--compact" data-reveal>
      <p class="section-number">02 / Experience</p>
      <h2 id="experience-title">Work shaped by the whole delivery cycle.</h2>
    </div>
    <div class="timeline">
      {experience.map((item) => (
        <article class="timeline-item" data-reveal>
          <div class="timeline-period" aria-hidden={!item.timeframe ? 'true' : undefined}>{item.timeframe}</div>
          <div class="timeline-title">
            <h3>{item.role}</h3>
            <p>{item.company}</p>
          </div>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="capabilities-section" aria-labelledby="capabilities-title">
    <div class="section-shell">
      <div class="capabilities-intro" data-reveal>
        <p class="section-number">03 / Capabilities</p>
        <h2 id="capabilities-title">Front-end depth with practical range.</h2>
      </div>
      <div class="skill-groups">
        {skillGroups.map((group, index) => (
          <div class="skill-group" data-reveal>
            <p class="skill-index">0{index + 1}</p>
            <h3>{group.label}</h3>
            <ul>
              {group.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section section-shell" id="about" aria-labelledby="about-title">
    <div class="section-heading" data-reveal>
      <p class="section-number">04 / About</p>
      <div>
        <h2 id="about-title">Thoughtful implementation starts with understanding the system.</h2>
        <p>{profile.bio}</p>
      </div>
    </div>

    <div class="about-details">
      <div class="about-detail" data-reveal>
        <p class="eyebrow">Education</p>
        {education.map((item) => (
          <div>
            <h3>{item.degree}</h3>
            <p>{item.institution}</p>
            <p>{item.timeframe} · {item.detail}</p>
          </div>
        ))}
      </div>

      <div class="about-detail" data-reveal>
        <p class="eyebrow">Credentials</p>
        <ul class="plain-list">
          {certifications.map((item) => (
            <li>
              {item.url ? (
                <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
              ) : (
                <span>{item.title}</span>
              )}
              <small class="detail-meta">{item.issuer} · {item.issued}</small>
              <small class="detail-summary">{item.summary}</small>
            </li>
          ))}
        </ul>
        <div class="supporting-documents">
          <p class="eyebrow">Supporting documents</p>
          {supportingDocuments.map((document) => (
            <a href={document.url} target="_blank" rel="noreferrer">
              {document.label} <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))}
        </div>
      </div>

      <div class="about-detail" data-reveal>
        <p class="eyebrow">Beyond the code</p>
        <ul class="plain-list">
          {organizations.map((item) => (
            <li>
              <span>{item.role}</span>
              <small class="detail-meta">{item.organization}{item.timeframe && ` · ${item.timeframe}`}</small>
              <small class="detail-summary">{item.summary}</small>
            </li>
          ))}
          <li><span>Indonesian · English CEFR B2</span></li>
        </ul>
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

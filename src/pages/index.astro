---
import { getCollection } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import {
  certifications,
  education,
  experience,
  organizations,
  skillGroups,
  supportingDocuments,
} from '../data/experience';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured);
---

<BaseLayout
  title={profile.name}
  description="Portfolio of Salsabilla Edlanda Putri, a Front-End Developer focused on Angular, TypeScript, and API-driven web applications."
  pageClass="home-page"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker"><span>SEP / Portfolio</span> {profile.role}</p>
      <h1 id="hero-title">
        <span>Salsabilla</span>
        <span>Edlanda Putri<span class="accent-dot">.</span></span>
      </h1>
      <p class="hero-statement">I build clear, responsive interfaces for real-world applications.</p>
      <p class="hero-intro">
        Angular, TypeScript, and REST API integration—backed by collaborative delivery experience for an Ireland-based company.
      </p>
      <div class="hero-actions">
        <a class="button" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
        <a class="text-link text-link--inverse" href="#contact">Contact me <span aria-hidden="true">↗</span></a>
        {profile.cvPath && (
          <a class="text-link text-link--inverse" href={profile.cvPath} download>Download CV <span aria-hidden="true">↓</span></a>
        )}
      </div>

      <dl class="hero-meta">
        <div>
          <dt>Based in</dt>
          <dd>Semarang, Indonesia</dd>
        </div>
        <div>
          <dt>Core stack</dt>
          <dd>Angular · TypeScript</dd>
        </div>
        {profile.phone && (
          <div>
            <dt>Direct line</dt>
            <dd><a href={`tel:${profile.phone.replace(/[\s-]/g, '')}`}>{profile.phone}</a></dd>
          </div>
        )}
      </dl>
    </div>

    <div class="hero-visual" aria-hidden="true" data-depth>
      <div class="visual-topline">
        <span>Frontend systems</span>
        <span>06° 58′ S</span>
      </div>
      <div class="visual-stage">
        <span class="visual-cross visual-cross--one">+</span>
        <span class="visual-cross visual-cross--two">+</span>
        <span class="hero-monogram">S</span>
        <span class="visual-coordinate">110° 25′ E</span>
      </div>
      <div class="visual-code">
        <span style="--line: 86%"></span>
        <span style="--line: 63%"></span>
        <span style="--line: 74%"></span>
        <span style="--line: 42%"></span>
      </div>
      <div class="hero-note">
        <span>Angular</span>
        <span>TypeScript</span>
        <span>REST APIs</span>
      </div>
    </div>
  </section>

  <div class="signal-strip" aria-label="Primary capabilities">
    <span>Responsive UI</span><span aria-hidden="true">●</span>
    <span>API integration</span><span aria-hidden="true">●</span>
    <span>Angular development</span><span aria-hidden="true">●</span>
    <span>Product delivery</span>
  </div>

  <section class="work-section section-shell" id="work" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <p class="section-number">01 — Selected work</p>
      <div>
        <h2 id="work-title">Selected work.<br />Real ownership.</h2>
        <p>
          Professional product work and academic systems, with each contribution separated clearly from the wider team effort.
        </p>
      </div>
    </div>
    <div class="selected-work">
      {featuredProjects.map((project, index) => (
        <ProjectPreview project={project} index={index} />
      ))}
    </div>
    <a class="section-link" href="/projects/">
      <span>View the full project archive</span>
      <span aria-hidden="true">06 projects ↗</span>
    </a>
  </section>

  <section class="experience-section section-shell" id="experience" aria-labelledby="experience-title">
    <div class="section-heading section-heading--compact" data-reveal>
      <p class="section-number">02 — Experience</p>
      <h2 id="experience-title">From interface detail to delivery.</h2>
    </div>
    <div class="timeline">
      {experience.map((item, index) => (
        <article class="timeline-item" data-reveal>
          <div class="timeline-period"><span aria-hidden="true">0{index + 1}</span>{item.timeframe}</div>
          <div class="timeline-title">
            <h3>{item.role}</h3>
            <p>{item.company} · Remote</p>
          </div>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="capabilities-section" aria-labelledby="capabilities-title">
    <div class="capabilities-mark" aria-hidden="true">TOOLKIT</div>
    <div class="section-shell">
      <div class="capabilities-intro" data-reveal>
        <p class="section-number">03 — Capabilities</p>
        <h2 id="capabilities-title">The stack behind the screens.</h2>
      </div>
      <div class="skill-groups">
        {skillGroups.map((group, index) => (
          <div class="skill-group" data-reveal>
            <p class="skill-index">0{index + 1}</p>
            <h3>{group.label}</h3>
            <ul>
              {group.skills.map((skill) => <li>{skill}<span aria-hidden="true">↗</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section section-shell" id="about" aria-labelledby="about-title">
    <div class="section-heading" data-reveal>
      <p class="section-number">04 — Profile</p>
      <div>
        <h2 id="about-title">A developer who thinks in systems.</h2>
        <p>{profile.bio}</p>
      </div>
    </div>

    <div class="about-details">
      <div class="about-detail about-detail--education" data-reveal>
        <p class="eyebrow">Education</p>
        {education.map((item) => (
          <div>
            <h3>{item.degree}</h3>
            <p>{item.institution}</p>
            <p>{item.timeframe} · {item.detail}</p>
          </div>
        ))}
      </div>

      <div class="about-detail" data-reveal>
        <p class="eyebrow">Credentials</p>
        <ul class="plain-list">
          {certifications.map((item) => (
            <li>
              {item.url ? (
                <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
              ) : (
                <span>{item.title}</span>
              )}
              <small class="detail-meta">{item.issuer} · {item.issued}</small>
              <small class="detail-summary">{item.summary}</small>
            </li>
          ))}
        </ul>
        <div class="supporting-documents">
          <p class="eyebrow">Verified documents</p>
          {supportingDocuments.map((document) => (
            <a href={document.url} target="_blank" rel="noreferrer">
              {document.label} <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))}
        </div>
      </div>

      <div class="about-detail" data-reveal>
        <p class="eyebrow">Leadership</p>
        <ul class="plain-list">
          {organizations.map((item) => (
            <li>
              <span>{item.role}</span>
              <small class="detail-meta">{item.organization}{item.timeframe && ` · ${item.timeframe}`}</small>
              <small class="detail-summary">{item.summary}</small>
            </li>
          ))}
          <li>
            <span>Languages</span>
            <small class="detail-meta">Indonesian · English CEFR B2</small>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>
